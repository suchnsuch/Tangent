{
	"compilerOptions": {
		"outDir": "../__build",
		"sourceMap": true,
		"rootDir": "..",
		"lib": ["ESNext", "DOM"],
		"moduleResolution": "bundler",
		"allowJs": true,
		"esModuleInterop": true,
		"target": "ESNext",
		"paths": {
			"*": ["../*"]
		},
		"verbatimModuleSyntax": true,
		"strict": false
	},
	"include": [
		".",
		"../common"
	]
}