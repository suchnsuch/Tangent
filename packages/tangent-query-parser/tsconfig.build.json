{
	"include": ["src/**/*"],
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "lib",
		"target": "ESNext",
		"strict": false,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"types": ["node"],

		"sourceMap": true,
		"declaration": true,
		"declarationMap": true
	}
}
